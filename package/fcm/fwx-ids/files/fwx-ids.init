#!/bin/sh /etc/rc.common
# FWX IDS Service

START=94
STOP=11
USE_PROCD=1

start_service() {
    /usr/bin/fwx-ids start
}

stop_service() {
    /usr/bin/fwx-ids stop
}

reload_service() {
    /usr/bin/fwx-ids restart
}

service_triggers() {
    procd_add_reload_trigger "fwx_ids"
}
