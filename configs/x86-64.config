# Target: x86-64
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# Image settings
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# Build options
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# Luci
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# FWX packages
CONFIG_PACKAGE_fwx=y
CONFIG_PACKAGE_fwxd=y
CONFIG_PACKAGE_fwx-ids=y
CONFIG_PACKAGE_fwx-threat=y
CONFIG_PACKAGE_libfwx_common=y
CONFIG_PACKAGE_luci-app-fwx=y
CONFIG_PACKAGE_luci-theme-fanchmwrt=y

# Network tools
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y

# Filesystem
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# USB support
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y

# Wireless (optional for x86)
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
